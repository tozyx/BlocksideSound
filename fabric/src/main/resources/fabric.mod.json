{
  "schemaVersion": 1,
  "id": "blocksidesound",
  "version": "${version}",
  "name": "BlocksideSound",
  "description": "Material-aware rain and carefully designed sound details for Minecraft.",
  "authors": [
    "tozyx"
  ],
  "contact": {
    "sources": "https://github.com/tozyx/BlocksideSound",
    "issues": "https://github.com/tozyx/BlocksideSound/issues"
  },
  "license": "GPL-3.0-only",
  "environment": "client",
  "mixins": [
    "blocksidesound.client.mixins.json"
  ],
  "entrypoints": {
    "client": [
      "com.tozyx.blocksidesound.fabric.BlocksideSoundFabricClient"
    ],
    "modmenu": [
      "com.tozyx.blocksidesound.fabric.BlocksideSoundModMenu"
    ]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_min_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
